<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CodeDesigner.Ps2.Multiplayer</AssemblyName>
    <RootNamespace>CodeDesigner.Ps2.Multiplayer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
  </ItemGroup>

  <!-- DNAS gateway (https://github.com/FatalityDevelopment/DnaSDK), hosted in-process by Servers/DnasServer.cs. -->
  <ItemGroup>
    <ProjectReference Include="..\DnaSDK\DnaSDK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="config.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <!-- Captured DNAS packets (Data/<region>/packets): DnaSDK takes each title's original RSA ticket from them. -->
    <Content Include="Data\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- DNAS gateway TLS certificates (cert-us/eu/jp per DnasRegion, ca-cert.pem issuer). -->
    <Content Include="Certificates\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- DnaSDK's optional RSA moduli (diagnostic ticket decode in <DnasRsaDirectory>/Decoded). -->
    <Content Include="..\DnaSDK\Assets\Moduli\*.BIN" Link="Assets\Moduli\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
