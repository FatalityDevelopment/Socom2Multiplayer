<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CodeDesigner.Ps2.Multiplayer</AssemblyName>
    <RootNamespace>CodeDesigner.Ps2.Multiplayer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
  </ItemGroup>

  <!-- DNAS gateway (https://github.com/FatalityDevelopment/DnaSDK), hosted in-process by Servers/DnasServer.cs. -->
  <ItemGroup>
    <ProjectReference Include="..\DnaSDK\DnaSDK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="config.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <!-- SOCOM II's original RSA-signed DNAS ticket, copied into the ticket root on start. -->
    <Content Include="Dnas\Signatures\*.BIN">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- DnaSDK's gateway TLS chain and optional RSA moduli, kept in DnaSDK so its updates come straight across. -->
    <Content Include="..\DnaSDK\TCP.TLS\Certificates\*.pem" Link="Certificates\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\DnaSDK\Assets\Moduli\*.BIN" Link="Assets\Moduli\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
